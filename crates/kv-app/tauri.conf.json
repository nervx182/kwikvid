{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kwikvid",
  "version": "0.0.1",
  "identifier": "dev.kwikvid.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "kwikvid",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
