{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kv-preview-spike",
  "version": "0.0.1",
  "identifier": "dev.kwikvid.previewspike",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "kwikvid preview spike",
        "width": 1280,
        "height": 720,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
